<?xml version="1.0" encoding="utf-8"?>
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

    <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <!-- 🔘 Кнопка старт/стоп -->
        <ToggleButton
                android:id="@+id/toggleButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textOn="⏹ Стоп"
                android:textOff="▶ Старт"
                android:layout_marginBottom="24dp"/>

        <!-- 📍 Координаты -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Местоположение"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tvLat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lat: --"
                android:padding="4dp"/>

        <TextView android:id="@+id/tvLon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lon: --"
                android:padding="4dp"/>

        <TextView android:id="@+id/tvAlt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alt: --"
                android:padding="4dp"/>

        <TextView android:id="@+id/tvAcc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acc: --"
                android:padding="4dp"/>

        <!-- 📡 Данные сети -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡 Сеть"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/tvNetwork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Network: --"
                android:padding="4dp"/>

        <TextView android:id="@+id/tvBand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Band: --"
                android:padding="4dp"/>

        <TextView android:id="@+id/tvMccMnc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MCC-MNC: --"
                android:padding="4dp"/>

        <TextView android:id="@+id/tvPci"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PCI: --"
                android:padding="4dp"/>

        <TextView android:id="@+id/tvRsrp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RSRP: --"
                android:padding="4dp"/>

        <TextView android:id="@+id/tvRssi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RSSI: --"
                android:padding="4dp"/>

    </LinearLayout>
</ScrollView>